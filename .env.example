# ==============================================================================
# RAYLAB — Environment Configuration
# Architecture : Next.js 15 + Turso / libSQL (SQLite-compatible)
# ==============================================================================

# Database Configuration (Optionnel)
# Par défaut, RayLab s'exécute directement en local avec SQLite (zero-config).
# Pour connecter votre instance Turso Cloud en production :
# TURSO_DATABASE_URL=libsql://votre-base.turso.io
# TURSO_AUTH_TOKEN=votre-token-turso

# Modèles IA (Opencode / Omniroute / OpenRouter)
# RayLab intègre un mentor IA avec un moteur local intelligent sans clé requise.
# Pour activer le routage vers les modèles gratuits sur Omniroute ou Opencode :
# OMNIROUTE_API_KEY=sk-or-v1-...
# OPENCODE_API_KEY=sk-opencode-...
# OPENROUTER_API_KEY=sk-or-v1-...
